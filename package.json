{
  "name": "open-yixiancard",
  "version": "1.0.0",
  "description": "Open-YiXianCard 原作证据驱动的弈仙牌战斗模拟、遥测与分析工作台",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:ts": "bun --preload=./scripts/ts-frozen-mock-preload.ts test engine-ts/__tests__",
    "generate:original-build-profiles": "bun battle-evaluator/scripts/build-original-build-profiles.ts",
    "generate:public-snapshot": "bun scripts/build-public-shared-snapshot.ts",
    "diff:engines": "bun scripts/diff-engine-events.ts",
    "check:worktree": "bun scripts/check-worktree.ts",
    "check:affected": "bun scripts/check-affected.ts",
    "check:bun-version": "bun scripts/check-bun-version.ts",
    "report:hidden-cards": "bun engine-ts/scripts/report-hidden-card-unlock.ts",
    "report:footprint": "bun scripts/report-footprint.ts",
    "card:evidence": "bun engine-ts/scripts/card-evidence-index.ts",
    "original:query": "bun engine-ts/scripts/original-query.ts",
    "audit:ts": "bun battle-evaluator/scripts/audit-evidence.ts",
    "audit:semantic-kernel": "bun engine-ts/scripts/audit-semantic-kernel.ts",
    "audit:runtime-provenance": "bun engine-ts/scripts/audit-runtime-provenance.ts",
    "records:original": "python3 research/original-game/inspect_battle_records.py",
    "records:resolve": "python3 research/original-game/resolve_record_code.py",
    "records:fixtures": "python3 research/original-game/export_record_fixtures.py",
    "records:screen": "bun engine-ts/scripts/records-screen.ts",
    "records:cultivation-audit": "python3 research/original-game/audit_cultivation_records.py",
    "records:mirror": "python3 research/original-game/ingest_mirror_records.py",
    "test:record-export": "cd research/original-game && python3 -m unittest test_ingest_mirror_records.py",
    "records:mirror-census": "python3 research/original-game/extract_mirror_deck_census.py",
    "oracle:mirror:run": "bun battle-evaluator/scripts/run-mirror-oracle.ts",
    "records:yiwen": "bun battle-evaluator/scripts/import-yiwen-record-oracle.ts",
    "records:yiwen-oracle": "bun battle-evaluator/scripts/import-yiwen-record-oracle.ts --oracle all",
    "records:yiwen:admit": "bun battle-evaluator/scripts/import-yiwen-record-oracle.ts --admit",
    "replay:admission": "bun battle-evaluator/scripts/replay-admission.ts",
    "replay:withdraw": "bun battle-evaluator/scripts/replay-subset-withdrawal.ts",
    "freeze:replay": "bun battle-evaluator/scripts/replay-baseline-freeze.ts",
    "freeze:replay:full": "bun battle-evaluator/scripts/replay-baseline-freeze.ts --full",
    "check:replay-baseline": "bun battle-evaluator/scripts/replay-baseline-freeze.ts --check",
    "oracle:golden:build": "bun battle-evaluator/scripts/original-oracle-build.ts",
    "oracle:golden:full:build": "bun battle-evaluator/scripts/original-oracle-build.ts --full-state",
    "oracle:golden:full:stage": "bun battle-evaluator/scripts/original-oracle-build.ts --full-state --stage",
    "oracle:golden:diff": "bun battle-evaluator/scripts/original-oracle-diff.ts",
    "oracle:rust:full-state-diff": "bun battle-evaluator/scripts/dump-aligned-rust-full-state.ts",
    "oracle:synthetic:catalog": "bun battle-evaluator/scripts/build-synthetic-oracle-catalog.ts",
    "report:synthetic-scope": "bun battle-evaluator/scripts/report-synthetic-oracle-scope.ts",
    "check:synthetic-scope": "bun battle-evaluator/scripts/report-synthetic-oracle-scope.ts --check",
    "report:synthetic-full-scope": "bun battle-evaluator/scripts/report-synthetic-full-scope.ts --write",
    "check:synthetic-full-scope": "bun battle-evaluator/scripts/report-synthetic-full-scope.ts --check",
    "report:synthetic-full-campaign-evidence": "bun battle-evaluator/scripts/report-synthetic-full-campaign-evidence.ts",
    "check:synthetic-full-campaign-evidence": "bun battle-evaluator/scripts/report-synthetic-full-campaign-evidence.ts --check",
    "report:synthetic-regression-evidence": "bun battle-evaluator/scripts/report-synthetic-regression-evidence.ts",
    "check:synthetic-regression-evidence": "bun battle-evaluator/scripts/report-synthetic-regression-evidence.ts --check",
    "report:synthetic-mechanism-families": "bun battle-evaluator/scripts/report-synthetic-oracle-mechanism-families.ts",
    "oracle:synthetic:build": "bun battle-evaluator/scripts/synthetic-oracle-build.ts",
    "oracle:synthetic:stage": "bun battle-evaluator/scripts/synthetic-oracle-build.ts --stage",
    "oracle:synthetic:run": "bun battle-evaluator/scripts/run-synthetic-oracle-sequence.ts",
    "oracle:synthetic:full:prepare": "bun battle-evaluator/scripts/run-synthetic-full-campaign.ts --prepare",
    "oracle:synthetic:full:run": "bun battle-evaluator/scripts/run-synthetic-full-campaign.ts --run",
    "oracle:synthetic:diff": "bun battle-evaluator/scripts/synthetic-oracle-diff.ts",
    "oracle:synthetic:verify-trace": "bun battle-evaluator/scripts/verify-synthetic-oracle-trace.ts",
    "report:replay-corpus": "bun battle-evaluator/scripts/generate-replay-corpus-manifest.ts",
    "check:replay-corpus": "bun battle-evaluator/scripts/generate-replay-corpus-manifest.ts --check",
    "check:corpus-provenance": "bun battle-evaluator/scripts/check-corpus-provenance.ts",
    "check:tui": "bun run check:rust:handler-dependencies && cargo check --manifest-path engine-rust/Cargo.toml --bin tui && cargo run --quiet --manifest-path engine-rust/Cargo.toml --bin tui -- --smoke",
    "test:ui:rust": "bun test src/ui/__tests__/battle-event-hooks.test.ts src/ui/__tests__/battle-event-source-registry.test.ts src/ui/__tests__/battle-view-layout.test.ts src/ui/__tests__/deck-diagnostics.test.ts src/ui/__tests__/derived-state.test.ts src/ui/__tests__/fixture-index-generation.test.ts src/ui/__tests__/generated-card-registration.test.ts src/ui/__tests__/hover-detail.test.ts src/ui/__tests__/layout-verification.test.ts src/ui/__tests__/main-actions-worker.test.ts src/ui/__tests__/replay-import.test.ts src/ui/__tests__/worker-client.test.ts src/ui/__tests__/worker-handler.test.ts",
    "audit:mechanics": "bun engine-ts/scripts/audit-mechanic-coverage.ts",
    "evidence:card-configs": "bun engine-ts/scripts/build-original-card-configs.ts",
    "evidence:card-combines": "bun battle-evaluator/scripts/build-original-card-combine-configs.ts",
    "evidence:manifest": "python3 research/original-game/build_evidence_manifest.py research/original-game/extracted/current research/original-game/EVIDENCE_MANIFEST.json --steam-build auto",
    "evidence:extract-build": "python3 research/original-game/extract_build.py",
    "evidence:rebuild": "python3 research/original-game/extract_build.py",
    "evidence:promote-current": "python3 research/original-game/extract_build.py --promote-only",
    "rotate:build": "bun scripts/rotate-build.ts",
    "screen:rotation": "bun scripts/screen-rotation.ts",
    "screen:hf": "bun scripts/screen-hf.ts",
    "test:screen:hf": "cd research/original-game && python3 -m unittest test_screen_hf_stream.py",
    "evidence:diff-build": "python3 research/original-game/diff_builds.py",
    "solve:deck": "cargo run --release --manifest-path engine-rust/Cargo.toml --bin solve_deck --",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "build:ui": "bun scripts/build-ui.ts",
    "build:site": "bun scripts/build-site.ts",
    "test:release": "bun test scripts/__tests__/release-artifact.test.ts",
    "check:release": "bun scripts/check-release-artifact.ts dist",
    "release:site": "bun run build:site && bun run check:release",
    "smoke:ui": "bun run build:ui && bun src/ui/scripts/browser-smoke.ts",
    "audit:ui": "bun run build:ui && bun src/ui/scripts/ui-self-audit.ts",
    "test:ui": "bun test src/ui/__tests__",
    "check:ui-fixture-index": "bun scripts/generate-ui-fixture-index.ts --check",
    "check:ui-fixtures": "bun run check:ui-fixture-index && bun test src/ui/__tests__/fixture-index-generation.test.ts",
    "check:rust:ui-card-catalog": "bun scripts/check-public-ui-card-catalog.ts",
    "check:ui": "bun run check:public-surface && bun run check:rust:ui-card-catalog && bun run test:ui && bun run smoke:ui && bun run audit:ui",
    "check:surfaces": "bun run check:ui",
    "check": "bun run check:bun-version && bun run check:public-surface && bun run check:rust:ui-card-catalog && tsc -p jsconfig.json --noEmit",
    "generate:rust:card-catalog": "bun engine-rust/scripts/generate-card-effect-catalog.ts",
    "generate:rust:handler-dependencies": "bun engine-rust/scripts/generate-rule-handler-dependencies.ts",
    "check:rust:contracts": "cargo test --manifest-path engine-rust/Cargo.toml --lib",
    "check:rust:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path engine-rust/Cargo.toml --lib && bun scripts/check-rust-wasm.ts",
    "check:rust:replay": "cargo test --manifest-path engine-rust/Cargo.toml && cargo clippy --manifest-path engine-rust/Cargo.toml --lib -- -D warnings",
    "check:rust:full": "bun run check:rust:replay && bun run check:rust:wasm && bun run report:rust-file-health && RUST_GIT_HEALTH_ALLOW_DIRTY=1 bun run report:rust-git-health",
    "check:rust": "bun run check:rust:full",
    "check:ts": "bun run check:ts:frozen && bun run check:ts:types",
    "report:rust-git-health": "bun scripts/report-rust-git-health.ts",
    "report:rust-file-health": "bun scripts/report-rust-file-health.ts",
    "serve": "bun run serve:ts",
    "serve:ts": "bun run build:ui && python3 -m http.server 3001",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:public-surface": "bun scripts/check-public-surface.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.0",
    "pinyin-pro": "^3.28.1",
    "prettier": "^3.9.6",
    "typescript": "7.0.2"
  }
}
