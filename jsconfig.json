{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "strict": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
